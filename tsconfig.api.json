{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "composite": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "api/**/*.ts",
    "server/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "build", "src"]
}